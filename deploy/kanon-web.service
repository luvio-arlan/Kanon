[Unit]
Description=KANON Investment Thesis OS (Next.js 16)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/kanon
Environment=NODE_ENV=production
Environment=PORT=3200
Environment=HOSTNAME=127.0.0.1
Environment=NODE_OPTIONS=--max-old-space-size=384
EnvironmentFile=-/srv/kanon/.env.local
ExecStart=/usr/local/bin/pnpm --filter @kanon/web start -H 127.0.0.1 -p 3200
Restart=always
RestartSec=3
MemoryMax=512M
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
