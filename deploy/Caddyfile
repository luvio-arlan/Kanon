www.kanon.hk {
	redir https://kanon.hk{uri} permanent
}

kanon.hk {
	root * /srv/kanon/marketing
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@static_assets path /assets/*
	header @static_assets Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

	file_server
}

app.kanon.hk {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy 127.0.0.1:3000 {
		# Keep SSE streams (AI IC Agent) unbuffered
		flush_interval -1
	}
}
