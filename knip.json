{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/**", "promo-video/**"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"]
    },
    "packages/core": {
      "entry": ["scripts/*.mjs"]
    },
    "apps/web": {
      "entry": ["e2e/**/*.{ts,mjs}"]
    }
  }
}
