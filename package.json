{
  "name": "kanon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:api": "node scripts/verify-api-contracts.mjs",
    "test:e2e": "pnpm --filter @kanon/web e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "design:check": "node scripts/wave-guards.test.mjs && node scripts/wave-guards-rs.test.mjs && node scripts/wave-guards-u.test.mjs && node scripts/wave-guards-v.test.mjs && node scripts/check-design-and-limits.mjs",
    "knip": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm design:check && pnpm knip",
    "db:push": "pnpm --filter @kanon/core db:push",
    "db:migrate": "pnpm --filter @kanon/core db:migrate",
    "eval": "node packages/ai/evals/run-evals.mjs --offline",
    "eval:live": "node packages/ai/evals/run-evals.mjs --live",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.9.0",
    "knip": "^6.47.0",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  }
}
