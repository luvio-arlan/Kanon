{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["sin1"],
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @kanon/web build",
  "crons": [
    {
      "path": "/api/internal/jobs/tick",
      "schedule": "0 22 * * *"
    }
  ]
}
