# Optional: External PostgreSQL (Neon / Supabase / Docker).
# Leave empty to run zero-config persistent local PostgreSQL via PGlite (.data/kanon-pg).
DATABASE_URL=

# Optional BYOK AI Provider Keys (set any one to enable live Vercel AI SDK structured generation).
# When omitted, KANON runs its deterministic first-principles grounded analyzer with identical Zod schemas.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
